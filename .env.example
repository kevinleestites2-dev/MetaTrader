# MetaTrader Configuration
# Copy this file to .env and fill in your values

# ============== SECURITY ==============
# Master encryption key for vault - generate a strong random key
METATRADER_MASTER_KEY=your_secure_master_key_here

# Vault file for encrypted key storage
VAULT_FILE=.vault.key

# Log file for tamper-evident logging
LOG_FILE=metatrader_log.db

# ============== CAPITAL & RISK ==============
# Total trading capital in USD
TOTAL_CAPITAL_USD=1000.0

# ============== TELEGRAM (Optional) ==============
# Telegram bot token for alerts
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID
TELEGRAM_CHAT_ID=

# ============== EXCHANGE API KEYS ==============
# Polymarket (for prediction markets)
POLYMARKET_API_KEY=

# Hyperliquid (if using their API)
HYPERLIQUID_API_KEY=
HYPERLIQUID_SECRET=